---
import { withBase } from '../lib/url';

interface HeroImage {
  src: string;
  alt?: string;
  credit?: string;
}

interface Props {
  images: HeroImage[];
  mode?: 'random' | 'slideshow';
  intervalMs?: number;
}

const { images, mode = 'random', intervalMs = 9000 } = Astro.props;
if (!images.length) throw new Error('HeroRotator requires at least one image.');
const resolvedImages = images.map((image) => ({ ...image, src: withBase(image.src) }));
---

<div class="hero-rotator" data-hero-rotator data-mode={mode} data-interval={intervalMs} aria-hidden="true">
  <img class="hero-rotator__image is-active" src={resolvedImages[0].src} alt="" fetchpriority="high" decoding="async" />
  <img class="hero-rotator__image" alt="" decoding="async" />
  <script is:inline type="application/json" class="hero-rotator__data" set:html={JSON.stringify(resolvedImages)} />
</div>

<script>
  function setupHeroRotator(root: HTMLElement) {
    const dataNode = root.querySelector<HTMLScriptElement>('.hero-rotator__data');
    const layers = [...root.querySelectorAll<HTMLImageElement>('.hero-rotator__image')];
    if (!dataNode || layers.length < 2) return;

    const images: Array<{ src: string }> = JSON.parse(dataNode.textContent || '[]');
    if (images.length < 2) return;

    const mode = root.dataset.mode || 'random';
    const intervalMs = Number(root.dataset.interval || 9000);
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeLayer = 0;
    let currentIndex = 0;

    const pickDifferentIndex = () => {
      if (images.length < 2) return 0;
      let next = currentIndex;
      while (next === currentIndex) next = Math.floor(Math.random() * images.length);
      return next;
    };

    const show = (index: number) => {
      if (index === currentIndex || !images[index]) return;
      const nextLayer = activeLayer === 0 ? 1 : 0;
      const incoming = layers[nextLayer];
      const outgoing = layers[activeLayer];
      const preload = new Image();
      preload.onload = () => {
        incoming.src = images[index].src;
        incoming.classList.add('is-active');
        outgoing.classList.remove('is-active');
        activeLayer = nextLayer;
        currentIndex = index;
      };
      preload.src = images[index].src;
    };

    if (mode === 'random') {
      show(pickDifferentIndex());
      return;
    }

    if (mode === 'slideshow' && !reduceMotion) {
      window.setInterval(() => {
        if (!document.hidden) show((currentIndex + 1) % images.length);
      }, Math.max(intervalMs, 4000));
    }
  }

  document.querySelectorAll<HTMLElement>('[data-hero-rotator]').forEach(setupHeroRotator);
</script>

<style>
  .hero-rotator{position:absolute;inset:0;overflow:hidden;background:#18201f}
  .hero-rotator__image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 53%;opacity:0;transition:opacity 1.15s ease;transform:scale(1.002)}
  .hero-rotator__image.is-active{opacity:1}
  .hero-rotator__data{display:none}
  @media(max-width:800px){.hero-rotator__image{object-position:center 50%}}
  @media(prefers-reduced-motion:reduce){.hero-rotator__image{transition:none}}
</style>