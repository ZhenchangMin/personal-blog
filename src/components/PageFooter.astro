---
import { withBase } from '../lib/url';

interface Props {
  note?: string;
}
const { note = '普通的一天，也值得留下来。' } = Astro.props;
---

<footer class="page-footer">
  <span>{note}</span>
  <div>
    <a href={withBase('/')}>首页</a>
    <a href={withBase('/moments')}>片刻</a>
    <a href={withBase('/archive')}>归档</a>
    <a href={withBase('/now')}>此刻</a>
  </div>
</footer>
