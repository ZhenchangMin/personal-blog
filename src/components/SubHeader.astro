---
import { withBase } from '../lib/url';

const currentPath = Astro.url.pathname;
const links = [
  { href: withBase('/#writing'), label: '写作' },
  { href: withBase('/moments'), label: '片刻' },
  { href: withBase('/projects'), label: '所做' },
  { href: withBase('/about'), label: '关于' },
];
---

<header class="sub-header">
  <a class="brand" href={withBase('/')} aria-label="返回首页">
    <strong>min</strong><span>留痕</span>
  </a>
  <nav aria-label="主导航">
    {links.map((link) => (
      <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>
</header>
