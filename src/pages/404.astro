---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubHeader from '../components/SubHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import { withBase } from '../lib/url';
import '../styles/interior.css';
import '../styles/foundation.css';
---

<BaseLayout title="页面不存在 · min的博客" description="页面不存在。" noIndex>
  <div class="page-shell">
    <SubHeader />
    <main class="not-found" id="main">
      <p class="page-kicker">404</p>
      <h1 class="page-title">没有找到这一页。</h1>
      <p class="page-lede">可能是地址发生了变化，或者页面已经删除。</p>
      <a class="not-found-link" href={withBase('/')}>回到首页 →</a>
    </main>
    <PageFooter />
  </div>
</BaseLayout>
