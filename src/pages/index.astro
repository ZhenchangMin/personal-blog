---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroRotator from '../components/HeroRotator.astro';
import { heroConfig } from '../config/site';
import { formatMonthDay, sortNewest } from '../lib/date';
import { withBase } from '../lib/url';
import '../styles/home.css';

const essays = sortNewest((await getCollection('essays')).filter((entry) => entry.data.status === 'public'));
const timeline = essays.slice(0, 6).map((entry) => ({
  date: entry.data.date,
  title: entry.data.title,
  description: entry.data.description,
  href: withBase(`/writing/${entry.id}`),
}));
---

<BaseLayout title="min的博客" description="min的个人博客" themeColor="#1f2928">
  <a class="skip-link" href="#main">跳到正文</a>

  <section class="cover" aria-label="首页封面">
    <HeroRotator images={heroConfig.images} mode={heroConfig.mode} intervalMs={heroConfig.intervalMs} />
    <div class="cover-shade" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href={withBase('/')} aria-label="首页"><strong>min</strong><span>的博客</span></a>
      <nav aria-label="主导航">
        <a href="#writing">写作</a>
        <a href={withBase('/archive')}>归档</a>
      </nav>
    </header>

    <div class="cover-copy">
      <h1>min的博客</h1>
    </div>

    <a class="cover-scroll" href="#main" aria-label="继续向下阅读"><i aria-hidden="true"></i></a>
  </section>

  <main id="main" class="content-shell">
    <section class="writing" id="writing">
      <div class="section-head">
        <h2>最近写下的</h2>
        <p>按时间排列。</p>
      </div>
      <div class="writing-list">
        {timeline.map((item) => (
          <a href={item.href}>
            <time datetime={item.date.toISOString()}>{formatMonthDay(item.date)}</time>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="subscribe" id="subscribe" aria-labelledby="subscribe-title">
      <div class="subscribe-copy">
        <p class="subscribe-kicker">SUBSCRIBE</p>
        <h2 id="subscribe-title">订阅博客更新</h2>
        <p>新的文章发布时，我会发一封邮件告诉你。不会频繁打扰，随时可以取消订阅。</p>
      </div>
      <div class="subscribe-form">
        <iframe
          title="订阅 min 的博客更新"
          width="540"
          height="305"
          src="https://e4309122.sibforms.com/v2/serve/MUIFAOKPVie7fgwmto1Ea4jDjraCD-ZLm3vjcRBH6pj3cmtkovJ0muizVeTrz62iLvWwcbu_9H-H11qWfCkMDzym_cv7SF4IT6wDgk_MpfdihQVb6gORZ6UP8OFZbAGViy3AJEF5REpPdXLNGB6MoZXkNdKaUjP47PiHzinGIyGXqWXa_-1OR7HsvMG4IKvs0dRiL3EzG9OlQK0j-w=="
          loading="lazy"
        ></iframe>
      </div>
    </section>

    <footer>
      <div class="footer-main">
        <span>min的博客</span>
        <div><a href="#subscribe">订阅</a><a href={withBase('/archive')}>归档</a><a href={withBase('/rss.xml')}>RSS</a></div>
      </div>
      <p class="photo-credit">封面：{heroConfig.images[0].credit}</p>
    </footer>
  </main>
</BaseLayout>
