---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroRotator from '../components/HeroRotator.astro';
import { heroConfig } from '../config/site';
import { formatMonthDay, sortNewest } from '../lib/date';
import { withBase } from '../lib/url';
import '../styles/home.css';

const essays = sortNewest((await getCollection('essays')).filter((entry) => entry.data.status === 'public'));
const logs = sortNewest((await getCollection('logs')).filter((entry) => entry.data.status === 'public'));
const momentEntries = sortNewest((await getCollection('moments')).filter((entry) => entry.data.status === 'public'));

const timeline = [
  ...essays.map((entry) => ({
      date: entry.data.date,
      title: entry.data.title,
      description: entry.data.description,
      href: withBase(`/writing/${entry.id}`),
    })),
  ...logs.map((entry) => ({
    date: entry.data.date,
    title: entry.data.title,
    description: entry.data.description,
    href: withBase(`/archive#${entry.id}`),
  })),
]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 3);

const homeMoments = await Promise.all(
  momentEntries.slice(0, 3).map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  }),
);
---

<BaseLayout title="min的博客" themeColor="#1f2928">
  <a class="skip-link" href="#main">跳到正文</a>

  <section class="cover" aria-label="首页封面">
    <HeroRotator images={heroConfig.images} mode={heroConfig.mode} intervalMs={heroConfig.intervalMs} />
    <div class="cover-shade" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href={withBase('/')} aria-label="首页"><strong>min</strong><span>的博客</span></a>
      <nav aria-label="主导航">
        <a href="#writing">写作</a>
        <a href={withBase('/moments')}>片刻</a>
        <a href={withBase('/about')}>关于</a>
      </nav>
    </header>

    <div class="cover-copy">
      <p class="season">二〇二六年 · 九月</p>
      <h1>min的博客</h1>
    </div>

    <a class="cover-scroll" href="#main" aria-label="继续向下阅读"><i aria-hidden="true"></i></a>
  </section>

  <main id="main" class="content-shell">
    <section class="now-bar" aria-labelledby="now-title">
      <div>
        <p id="now-title">此刻</p>
        <time datetime="2026-09">2026 · 09</time>
      </div>
      <p>在学校学习和生活。做研究，写代码，也开始认真想以后想成为怎样的人。</p>
      <a href={withBase('/now')}>现在的我</a>
    </section>

    <section class="writing" id="writing">
      <div class="section-head">
        <h2>最近写下的</h2>
        <p>长一点的思考与记录。这里不按领域分栏，只按时间留下来。</p>
      </div>
      <div class="writing-list">
        {timeline.map((item) => (
          <a href={item.href}>
            <time datetime={item.date.toISOString()}>{formatMonthDay(item.date)}</time>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="moments" id="moments">
      <div class="moments-visual" role="img" aria-label="照片型片刻的视觉占位，以后替换为自己的照片">
        <div class="moments-caption">
          <small>2026 · 08 · 31</small>
          <span>生活不是素材，<br />它本身就是正文。</span>
        </div>
      </div>
      <div class="moments-copy">
        <div class="section-head compact">
          <h2>片刻</h2>
          <p>没有必要成为一篇文章。</p>
        </div>
        {homeMoments.map(({ entry, Content }) => (
          <article>
            <time datetime={entry.data.date.toISOString()}>{formatMonthDay(entry.data.date)}</time>
            <Content />
          </article>
        ))}
        <a class="more" href={withBase('/moments')}>更多片刻</a>
      </div>
    </section>

    <footer id="about">
      <div class="footer-main">
        <p>认真生活，也认真留下痕迹。</p>
        <div><a href={withBase('/archive')}>归档</a><a href={withBase('/about')}>关于</a></div>
      </div>
      <p class="photo-credit">当前封面：{heroConfig.images[0].credit}。以后可在配置中加入自己的照片并选择随机或轮播模式。</p>
    </footer>
  </main>
</BaseLayout>
