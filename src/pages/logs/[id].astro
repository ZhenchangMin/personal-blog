---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubHeader from '../../components/SubHeader.astro';
import PageFooter from '../../components/PageFooter.astro';
import '../../styles/interior.css';
import { formatDate } from '../../lib/date';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const entries = (await getCollection('logs')).filter((entry) => entry.data.status === 'public');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} · min / 留痕`} description={entry.data.description} themeColor="#eceae3">
  <a class="skip-link" href="#main">跳到正文</a>
  <div class="page-shell">
    <SubHeader />
    <main id="main">
      <header class="article-hero">
        <p class="page-kicker">LOG · LIFE</p>
        <h1 class="page-title">{entry.data.title}</h1>
        <p class="page-lede">{entry.data.description}</p>
        <div class="article-meta">
          <span>{formatDate(entry.data.date)}</span>
          <div>
            {entry.data.location && <span>{entry.data.location}</span>}
            {entry.data.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </div>
      </header>

      <article class="article-body">
        <aside class="article-aside"><strong>这一页</strong>一段时间的生活切片，不要求写成工作总结。</aside>
        <div class="article-prose">
          <Content />
          <p class="end-note">{formatDate(entry.data.date)}</p>
        </div>
        <div class="article-next">
          <a href={withBase('/archive')}><small>← 回到归档</small><strong>看看时间留下的其他东西</strong></a>
          <a href={withBase('/moments')}><small>接下来 →</small><strong>看看一些片刻</strong></a>
        </div>
      </article>
    </main>
    <PageFooter />
  </div>
</BaseLayout>