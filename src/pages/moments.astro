---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SubHeader from '../components/SubHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import '../styles/interior.css';
import { formatDate, sortNewest } from '../lib/date';
import { withBase } from '../lib/url';

const entries = sortNewest((await getCollection('moments')).filter((entry) => entry.data.status === 'public'));
const rendered = await Promise.all(entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })));
---

<BaseLayout title="片刻 · min / 留痕" description="一些不需要长成文章的东西。">
  <a class="skip-link" href="#main">跳到正文</a>
  <div class="page-shell">
    <SubHeader />
    <main id="main">
      <header class="moments-head">
        <p class="page-kicker">MOMENTS</p>
        <h1 class="page-title">一些片刻</h1>
        <p class="page-lede">一句话、一张照片、一个还没有长成文章的念头。这里不要求完整，只负责把当时留下来。</p>
      </header>

      <section class="moments-feed" aria-label="片刻时间流">
        {rendered.map(({ entry, Content }) => (
          <article class:list={['moment-row', !entry.data.photo && 'short']} id={entry.id}>
            <time class="moment-date" datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
            <div class="moment-content">
              <Content />
              {entry.data.photo && (
                <figure class="moment-photo real-photo">
                  <img src={withBase(entry.data.photo)} alt={entry.data.photoAlt ?? ''} loading="lazy" decoding="async" />
                </figure>
              )}
              {entry.data.location && <small class="moment-location">{entry.data.location}</small>}
            </div>
          </article>
        ))}
      </section>
    </main>
    <PageFooter note="有些东西不必长成文章，也值得留在时间里。" />
  </div>
</BaseLayout>