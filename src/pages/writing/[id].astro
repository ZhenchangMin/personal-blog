---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubHeader from '../../components/SubHeader.astro';
import PageFooter from '../../components/PageFooter.astro';
import '../../styles/interior.css';
import { formatDate, sortNewest } from '../../lib/date';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const entries = sortNewest((await getCollection('essays')).filter((entry) => entry.data.status === 'public'));
  return entries.map((entry, index) => ({
    params: { id: entry.id },
    props: {
      entry,
      olderEntry: entries[index + 1] ?? null,
      newerEntry: entries[index - 1] ?? null,
    },
  }));
}

const { entry, olderEntry, newerEntry } = Astro.props;
const writingHref = withBase('/#writing');
const { Content } = await render(entry);
const kindLabel = entry.data.kind === 'learn' ? 'LEARN · NOTE' : 'ESSAY · THINK';
---

<BaseLayout title={`${entry.data.title} · min的博客`} description={entry.data.description} themeColor="#eceae3" type="article">
  <a class="skip-link" href="#main">跳到正文</a>
  <div class="page-shell">
    <SubHeader />
    <main id="main">
      <header class="article-hero">
        <p class="page-kicker">{kindLabel}</p>
        <h1 class="page-title">{entry.data.title}</h1>
        <p class="page-lede">{entry.data.description}</p>
        <div class="article-meta">
          <span>{formatDate(entry.data.date)}</span>
          <div>
            {entry.data.location && <span class="article-location">{entry.data.location}</span>}
            {entry.data.tags.map((tag) => <span class="article-tag">{tag}</span>)}
          </div>
        </div>
      </header>
    </main>
  </div>

  {entry.data.heroImage && (
    <div
      class="article-banner"
      role="img"
      aria-label={entry.data.heroAlt ?? ''}
      style={`--article-banner-image: url('${withBase(entry.data.heroImage)}')`}
    ></div>
  )}

  <div class="page-shell">
    <article class:list={['article-body', { 'no-banner': !entry.data.heroImage }]}>
      <div class="article-prose">
        <Content />
        <p class="end-note">
          {formatDate(entry.data.date)}
          {entry.data.location ? ` · ${entry.data.location}` : ''}
        </p>
      </div>

      <div class="article-next">
        {olderEntry ? (
          <a href={withBase(`/writing/${olderEntry.id}`)}>
            <small>← 上一篇</small>
            <strong>{olderEntry.data.title}</strong>
          </a>
        ) : (
          <a href={writingHref}>
            <small>← min的博客</small>
            <strong>回到最近写下的</strong>
          </a>
        )}

        {newerEntry ? (
          <a href={withBase(`/writing/${newerEntry.id}`)}>
            <small>下一篇 →</small>
            <strong>{newerEntry.data.title}</strong>
          </a>
        ) : (
          <a href={writingHref}>
            <small>min的博客 →</small>
            <strong>回到最近写下的</strong>
          </a>
        )}
      </div>
    </article>

    <PageFooter />
  </div>
</BaseLayout>